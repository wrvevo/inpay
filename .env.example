# Somente ambiente local. Não usar credenciais de produção.
# Copie para .env na raiz. O Compose interpola esse arquivo automaticamente.
LOCAL_PASSWORD=local-only-change-me
GRAFANA_PASSWORD=local-only-change-me
SERVICE_MEMORY_LIMIT=512m

# Obrigatórias para o demo. DEMO_CONNECTOR_AUTHORIZATION é Basic base64("developer:" + LOCAL_PASSWORD).
STORE_ADMIN_PASSWORD=local-only-change-me
DEMO_CONNECTOR_AUTHORIZATION=Basic ZGV2ZWxvcGVyOmxvY2FsLW9ubHktY2hhbmdlLW1l
